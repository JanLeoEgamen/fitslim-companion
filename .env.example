# ─────────────────────────────────────────────────────────────
# FitSlim AI — environment variables (template)
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Public (safe to expose to the browser) VITE_* variables are meant to be
# visible to clients. Every other variable is server/runtime-only.
# ─────────────────────────────────────────────────────────────

# Supabase — project ref whkdijufavdgzytcaaxs
VITE_SUPABASE_URL=https://whkdijufavdgzytcaaxs.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Supabase — server-only (never prefix with VITE_ or it ships to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Supabase CLI (needs "supabase:db" password for remote operations)
SUPABASE_PROJECT_REF=whkdijufavdgzytcaaxs
SUPABASE_DB_PASSWORD=change-me
# Personal access token for `supabase` CLI (list orgs/projects, push migrations).
SUPABASE_ACCESS_TOKEN=sbp_youraccesstoken

# AI Chatbot backend (server-only — never prefix these with VITE_)
# Cloudflare Workers AI
AI_BASE_URL=https://api.cloudflare.com/client/v4/accounts/a2735811473f67fda4e1c0e1febe5180/ai/v1/chat/completions
AI_MODEL=@cf/meta/llama-3.2-3b-instruct
AI_API_KEY=cfut_yourkey